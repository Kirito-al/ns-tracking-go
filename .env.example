# 环境变量模板
# 使用方法：cp .env.example .env，然后修改 .env 中的实际值

# ========== 云途业务配置 ==========
# 云途普通账号 API Token
YUN_EXPRESS_TOKEN=your_yunexpress_token_here

# 云途 GE 账号 API Token
GE_YUN_EXPRESS_TOKEN=your_ge_yunexpress_token_here

# 云途 Webhook 签名密钥（普通账号）
YUN_EXPRESS_WEBHOOK_SECRET=your_webhook_secret_here

# 云途 Webhook 签名密钥（GE 账号）
GE_YUN_EXPRESS_WEBHOOK_SECRET=your_ge_webhook_secret_here

# ========== 数据库配置 ==========
# PostgreSQL 连接字符串
DATABASE_URL=postgres://postgres:123456@localhost:5432/ns_admin_webhook_development

# ========== Redis 配置 ==========
# Redis 地址
REDIS_HOST=localhost:6379

# Redis 密码（没有密码留空）
REDIS_PASSWORD=

# Redis DB（默认 0）
REDIS_DB=0

# ========== 服务发现配置 ==========
# Etcd 地址（开发环境）
ETCD_ENDPOINTS=http://localhost:2379

# Consul 地址（生产环境可选）
# CONSUL_HOST=localhost:8500

# Nacos 地址（生产环境可选）
# NACOS_HOST=localhost:8848

# ========== 日志配置 ==========
# 日志级别：debug, info, warn, error
LOG_LEVEL=info

# 日志模式：dev, prod
LOG_MODE=dev

# ========== 应用配置 ==========
# 应用运行模式：dev, test, prod
APP_MODE=dev

# HTTP 服务端口
HTTP_PORT=8081

# gRPC 服务端口
GRPC_PORT=50051